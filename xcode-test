#!/bin/bash

# xcode-test: Run Xcode tests with detailed failure reporting

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

show_help() {
    cat <<EOF
Usage: xcode-test <scheme> [options] [-- extra xcodebuild flags]

Run Xcode tests with concise counts, warnings, and detailed failure reporting.

Arguments:
  scheme              The Xcode scheme to test (required)

Options:
  -h, --help          Show this help message
  -destination DEST   Test destination
  --result-path PATH  Path for .xcresult bundle (default: \$TMPDIR/<scheme>Test.xcresult)

Examples:
  xcode-test MyMacApp
  xcode-test MyApp -destination "platform=iOS Simulator,name=iPhone 18 Pro"
  xcode-test MyApp --result-path ./results.xcresult
  xcode-test MyApp -- -only-testing:MyAppTests/SomeTest
EOF
}

# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/test-results.sh
source "$SCRIPT_DIR/lib/test-results.sh"

ACCEPTS_RESULT_PATH=1
parse_arguments "$@"

if ! command -v jq &>/dev/null; then
    echo "Missing required dependency: jq (install with brew install jq)" >&2
    exit 1
fi

SCHEME="${POSITIONAL[0]}"

if [[ -z "$RESULT_PATH" ]]; then
    RESULT_PATH="${TMPDIR:-/tmp}/${SCHEME}Test.xcresult"
fi

run_xcodebuild test -scheme "$SCHEME" ${DEST_ARGS[@]+"${DEST_ARGS[@]}"} \
    -resultBundlePath "$RESULT_PATH" \
    ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}

if [[ "$XCODEBUILD_OUTPUT" == *"TEST SUCCEEDED"* ]]; then
    print_test_success "$RESULT_PATH" "$XCODEBUILD_OUTPUT"
    exit 0
fi

BUILD_ERRORS=$(extract_errors "$XCODEBUILD_OUTPUT")
if [[ -n "$BUILD_ERRORS" ]]; then
    echo "✗ Build failed:"
    echo ""
    echo "$BUILD_ERRORS"
    exit 1
fi

TEST_FAILURES=$(extract_test_failures "$RESULT_PATH")

if [[ -n "$TEST_FAILURES" ]]; then
    echo "✗ Tests failed:"
    echo ""
    echo "$TEST_FAILURES"
    exit 1
fi

# No source errors and no recorded test failures: the build or test runner
# itself failed (linking, signing, destination, crash before reporting).
echo "✗ Test run failed:"
echo ""
show_fallback_errors "$XCODEBUILD_OUTPUT"
echo "Result bundle: $RESULT_PATH"
exit 1
